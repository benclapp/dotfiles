#!/bin/sh

remote="$1"

stdin=$(cat)

targets_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    targets_main=1
  fi
done <<EOF
$stdin
EOF

if [ "$targets_main" -eq 1 ]; then
  if ( : </dev/tty ) 2>/dev/null; then
    printf 'You are pushing main to %s. Continue? [y/N] ' "$remote" >/dev/tty
    read -r reply </dev/tty
    case "$reply" in
      y | Y) ;;
      *)
        echo "Push cancelled." >&2
        exit 1
        ;;
    esac
  else
    echo "pre-push: no terminal available to confirm push to main. Push cancelled." >&2
    exit 1
  fi
fi

repo_hook="$(git rev-parse --git-dir)/hooks/pre-push"
if [ -x "$repo_hook" ]; then
  printf '%s\n' "$stdin" | "$repo_hook" "$@"
fi
